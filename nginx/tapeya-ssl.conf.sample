# Tapeya – SSL (HTTPS) server blocks
# Use with certbot/Let's Encrypt. Include this file inside each server {} in tapeya.conf
# after obtaining certs, or replace listen 80 with the blocks below.
#
# Certbot example:
#   certbot certonly --webroot -w /var/www/tapeya/api/public -d api.tapeya.com
#   certbot certonly --webroot -w /var/www/tapeya/app/dist     -d tapeya.com
#   certbot certonly --webroot -w /var/www/tapeya/backoffice/dist/backoffice/browser -d backoffice.tapeya.com
#   certbot certonly --webroot -w /var/www/tapeya/app/dist-graphics -d graphics.tapeya.com

# API – api.tapeya.com (HTTPS)
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name api.tapeya.com;
#     ssl_certificate     /etc/letsencrypt/live/api.tapeya.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/api.tapeya.com/privkey.pem;
#     include snippets/ssl-params.conf;  # optional: modern SSL settings
#     # ... same root, location /, location ~ \.php$, etc. as in tapeya.conf ...
# }

# App – tapeya.com (HTTPS)
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name tapeya.com;
#     ssl_certificate     /etc/letsencrypt/live/tapeya.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/tapeya.com/privkey.pem;
#     # ... same root and locations as in tapeya.conf ...
# }

# Backoffice – backoffice.tapeya.com (HTTPS)
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name backoffice.tapeya.com;
#     ssl_certificate     /etc/letsencrypt/live/backoffice.tapeya.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/backoffice.tapeya.com/privkey.pem;
#     # ... same root and locations as in tapeya.conf ...
# }

# Graphics overlay – graphics.tapeya.com (HTTPS)
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name graphics.tapeya.com;
#     ssl_certificate     /etc/letsencrypt/live/graphics.tapeya.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/graphics.tapeya.com/privkey.pem;
#     # ... same root and locations as graphics server in tapeya.conf ...
# }

# Optional: redirect HTTP → HTTPS (add to each server that listens on 80)
# location / {
#     return 301 https://$host$request_uri;
# }
