{
  "name": "backoffice",
  "version": "1.0.0",
  "description": "Tapeya backoffice – full packages + structure, minimal pages. Build your own routes and pages.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng run backoffice:lint",
    "lint:fix": "ng run backoffice:lint --fix",
    "lint:ci": "ng run backoffice:lint --format=stylish",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json,css,md}\"",
    "fix": "npm run lint:fix && npm run format"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.3",
    "@angular/cdk": "^21.0.2",
    "@angular/common": "^21.0.3",
    "@angular/compiler": "^21.0.3",
    "@angular/core": "^21.0.3",
    "@angular/forms": "^21.0.3",
    "@angular/material": "^21.0.2",
    "@angular/platform-browser": "^21.0.3",
    "@angular/platform-browser-dynamic": "^21.0.3",
    "@angular/router": "^21.0.3",
    "@ng-matero/extensions": "^21.0.0",
    "@tailwindcss/postcss": "^4.1.13",
    "angular-calendar": "^0.31.1",
    "angular-draggable-droppable": "^9.0.1",
    "angular-resizable-element": "^8.0.0",
    "angular-tabler-icons": "^3.26.0",
    "apexcharts": "^4.7.0",
    "chance": "^1.1.13",
    "date-fns": "^4.1.0",
    "highlight.js": "^11.11.1",
    "ng-apexcharts": "^1.16.0",
    "ng2-search-filter": "^0.5.1",
    "ngx-dropzone": "^3.1.0",
    "ngx-editor": "^19.0.0-beta.1",
    "ngx-highlightjs": "^14.0.1",
    "ngx-owl-carousel-o": "^20.0.1",
    "ngx-pagination": "^6.0.3",
    "ngx-permissions": "^19.0.0",
    "ngx-scrollbar": "^18.0.0",
    "ngx-toastr": "^19.1.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.2",
    "sass": "^1.95.0",
    "tailwindcss": "^4.1.13",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "~21.0.2",
    "@angular/compiler-cli": "^21.0.3",
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/schematics": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@types/aos": "^3.0.7",
    "@types/chance": "^1.1.7",
    "@types/date-fns": "^2.6.3",
    "@types/jasmine": "^5.1.13",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@eslint/js": "^9.15.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "typescript-eslint": "^8.15.0",
    "jasmine-core": "^5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
