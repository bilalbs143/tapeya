{
  "name": "tapeya-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "VITE_API_URL=https://api.tapeya.com/api/v1 VITE_APP_URL=https://tapeya.com vite build",
    "build:staging": "VITE_API_URL=https://dev-api.tapeya.com/api/v1 VITE_APP_URL=https://dev.tapeya.com vite build",
    "cap:sync": "cap sync && npm run ios:pods",
    "cap:sync:ios": "cap sync ios && npm run ios:pods",
    "ios:pods": "pod install --project-directory=ios/App",
    "cap:open:ios": "open ios/App/App.xcworkspace",
    "cap:ios": "VITE_API_URL=https://api.tapeya.com/api/v1 VITE_APP_URL=https://tapeya.com VITE_NATIVE_PLATFORM=ios vite build && npm run cap:sync:ios && npm run cap:open:ios",
    "cap:ios:staging": "VITE_API_URL=https://dev-api.tapeya.com/api/v1 VITE_APP_URL=https://dev.tapeya.com VITE_NATIVE_PLATFORM=ios vite build && npm run cap:sync:ios && npm run cap:open:ios",
    "cap:android": "VITE_API_URL=https://api.tapeya.com/api/v1 VITE_APP_URL=https://tapeya.com VITE_NATIVE_PLATFORM=android vite build && cap sync android && cap open android",
    "cap:android:staging": "VITE_API_URL=https://dev-api.tapeya.com/api/v1 VITE_APP_URL=https://dev.tapeya.com VITE_NATIVE_PLATFORM=android vite build && cap sync android && cap open android",
    "cap:android:bundle": "VITE_API_URL=https://api.tapeya.com/api/v1 VITE_APP_URL=https://tapeya.com VITE_NATIVE_PLATFORM=android vite build && cap sync android && cd android && ./gradlew :app:bundleRelease",
    "cap:android:bundle:staging": "VITE_API_URL=https://dev-api.tapeya.com/api/v1 VITE_APP_URL=https://dev.tapeya.com VITE_NATIVE_PLATFORM=android vite build && cap sync android && cd android && ./gradlew :app:bundleRelease",
    "verify:android:bundle": "keytool -printcert -jarfile android/app/build/outputs/bundle/release/app-release.aab | grep -E 'Owner|SHA1:'",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run lint:fix && npm run format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/react": "^11.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "hls.js": "^1.7.3",
    "laravel-echo": "^2.6.1",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "msw@2.15.0": true,
    "unrs-resolver@1.12.2": true
  }
}
