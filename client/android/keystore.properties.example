# Copy this file to keystore.properties (same folder as this file) and fill in real values.
# keystore.properties is gitignored — do not commit it.
#
# Use the existing Play upload key for com.tapbytapeya.app (same as legacy app/).
# Do NOT generate a new keystore — Play rejects a new upload key.
# See docs/ANDROID_PLAY_RELEASE.md (paths there still say app/android; use this
# client/android folder the same way).
#
# Paths in storeFile are relative to this android/ directory.

storeFile=keystores/upload-keystore.jks
storePassword=REPLACE_ME
keyPassword=REPLACE_ME
keyAlias=upload
