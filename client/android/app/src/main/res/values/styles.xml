<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      Manifest default launch theme (preview before onCreate). Real light/dark is chosen in
      MainActivity via NoActionBarLaunch.Light / .Dark with hardcoded splash colors — Android 12
      OS splash does not flip @color/splash_background from AppCompat night mode.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBarLaunch.Light" />

    <style name="AppTheme.NoActionBarLaunch.Light" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#F3F4F8</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_system_icon_light</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Dark" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#13131B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_system_icon_dark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
