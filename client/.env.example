# Use 127.0.0.1 (not localhost) — on macOS localhost often hits ::1, and Cursor
# may already be bound to [::1]:8000, which returns {"error":"Endpoint not found"}.
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_APP_URL=http://localhost:5180

# CDN origin is not a Vite env — runtime uses system setting `cdn_public_base_url`
# (fallback https://cdn.tapeya.com in shared/lib/cdn).

# Optional local only — production/staging/Cap pin these in scripts/run-vite-build.mjs.
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
