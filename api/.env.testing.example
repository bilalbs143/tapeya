APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Dedicated PostgreSQL database for PHPUnit / artisan test — never use dev/prod DB names here.
# Copy to .env.testing and adjust credentials (Homebrew Postgres often uses your OS username, not "postgres").
#
# If tests fail with duplicate/missing table errors, reset the test DB (do not run multiple
# test processes against tapeya_test at the same time):
#   php artisan db:wipe --env=testing --force && php artisan migrate --env=testing --force
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tapeya_test
DB_USERNAME=
DB_PASSWORD=

BROADCAST_CONNECTION=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
