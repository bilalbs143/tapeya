APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# -----------------------------------------------------------------------------
# Application settings (Spatie `settings` table)
# -----------------------------------------------------------------------------
# Store URLs, support contacts, overlay, SMS driver text, OTP test phones, WhatsApp,
# admin notification emails, etc. are persisted in the database — not in .env.
# Edit them in the admin backoffice (System Settings) after deploy, or seed defaults:
#   php artisan db:seed --class=Database\Seeders\SystemSettingsSeeder
# Optional table name override:
# SETTINGS_TABLE=settings

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tapeya
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
# Idle minutes before web session expires (525600 ≈ 365 days). Sanctum bearer tokens: config/sanctum.php `expiration` (null = no time expiry).
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting: null (off), log, reverb. With reverb, run `composer reverb` (or add to `composer dev`).
BROADCAST_CONNECTION=reverb

# Laravel Reverb (Pusher-compatible WebSockets). Generate unique APP_KEY / APP_SECRET for each environment.
# If REVERB_APP_KEY is ever rotated away from the default below, it must also be updated in every
# client: app/package.json build:* / build:graphics:* (optional VITE_REVERB_APP_KEY), and
# backoffice/src/environments/environment*.ts (reverb.appKey) — otherwise those clients'
# WebSocket auth silently fails to connect.
REVERB_APP_ID=100000
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Comma-separated hostnames for Reverb (default *). Full URLs are normalized to host only.
# Include graphics.tapeya.com so vMix browser sources can subscribe to public match.*.graphics channels.
# Include `localhost` for the Capacitor mobile app — its WebView origin is `capacitor://localhost`
# (iOS) or `https://localhost` (Android, see app/capacitor.config.json androidScheme), and Reverb's
# verifyOrigin() compares only the parsed host, so `localhost` alone covers both. Without it every
# Echo connection from the native app is closed with `pusher:error` code 4009 "Origin not allowed".
# REVERB_ALLOWED_ORIGINS=tapeya.com,graphics.tapeya.com,backoffice.tapeya.com,localhost

# Comma-separated browser origins for Laravel API CORS (unset = allow all, fine for local dev).
# Web origins only — Capacitor/Ionic WebViews are allowed via allowed_origins_patterns in config/cors.php.
# Production example:
# CORS_ALLOWED_ORIGINS=https://tapeya.com,https://graphics.tapeya.com,https://backoffice.tapeya.com

FILESYSTEM_DISK=local

# FFmpeg for reel poster (WebP) + transcode. Needs libwebp (Homebrew: `brew install ffmpeg-full`).
# ffmpeg-full is keg-only — point at it when the default `ffmpeg` bottle lacks libwebp:
# FFMPEG_PATH=/usr/local/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/usr/local/opt/ffmpeg-full/bin/ffprobe
# Apple Silicon Homebrew prefix is usually /opt/homebrew/opt/ffmpeg-full/bin/...

# Use "sync" so notifications (order placed, user registered) run immediately without a queue worker.
# Use "database" and run `php artisan queue:work` when you want background jobs.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Fail fast on a stuck Redis socket (seconds). Without this, a hung SCAN/publish can burn
# PHP max_execution_time (30s) and leave mobile /end requests failing with FETCH_ERROR.
REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=2

MAIL_MAILER=log
# SMTP (e.g. Hostinger): port 465 + MAIL_SCHEME=smtps, or port 587 + MAIL_SCHEME=null and tls via your provider
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (Backblaze B2 in production) + Cloudflare CDN
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Cloudflare public hostname (fallback when Admin CDN setting is empty)
AWS_URL=
# B2 S3 endpoint, e.g. https://s3.us-west-004.backblazeb2.com
AWS_ENDPOINT=
# Media disk: public (local) or s3 (B2 / S3-compatible)
MEDIA_DISK=public
# Production: MEDIA_DISK=s3. Set CDN base URL in Admin → System Settings (or AWS_URL).
# Raise PHP upload limits in public/.user.ini (defaults are often too low).
# Reels limits live in Admin → System Settings → Reels.
# See docs/MEDIA_CDN_MIGRATION.md

# Used by Vite-powered frontends that read Laravel env at build time (e.g. backoffice).
VITE_APP_NAME="${APP_NAME}"
