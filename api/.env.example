APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use "sync" so notifications (order placed, user registered) run immediately without a queue worker.
# Use "database" and run `php artisan queue:work` when you want background jobs.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# SMTP (e.g. Hostinger): port 465 + MAIL_SCHEME=smtps, or port 587 + MAIL_SCHEME=null and tls via your provider
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notifications: admin emails (comma-separated) receive order alerts etc. (e.g. hello@tapeya.com)
NOTIFICATION_ADMIN_EMAILS=

# SMS: log (dev), null (disable), api (generic ApiSmsDriver), veevotech (VeevoTech v3 sendsms).
SMS_DRIVER=log
# Sender label for VeevoTech (e.g. Default) or your registered sender ID.
SMS_FROM=Default

# VeevoTech: SMS_API_KEY = API hash; optional override URL (default https://api.veevotech.com/v3/sendsms)
# SMS_API_URL=https://api.veevotech.com/v3/sendsms
# SMS_API_KEY=
# Generic SMS API (when SMS_DRIVER=api – see ApiSmsDriver)
# SMS_API_SECRET=

# OTP SMS body; :code is replaced with the 6-digit OTP.
# SMS_OTP_MESSAGE="Tapeya: Your verification code is :code. Valid for 10 minutes. Do not share this code."

# S3 + CloudFront (set for media to be stored on S3 and served via CloudFront)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# CloudFront URL for S3 assets (e.g. https://xxxx.cloudfront.net)
AWS_URL=
# Media disk: public (local) or s3 (S3 + CloudFront)
MEDIA_DISK=public

VITE_APP_NAME="${APP_NAME}""${APP_NAME}"
