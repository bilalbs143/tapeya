APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# -----------------------------------------------------------------------------
# Application settings (Spatie `settings` table)
# -----------------------------------------------------------------------------
# Store URLs, support contacts, overlay, SMS driver text, OTP test phones, WhatsApp,
# admin notification emails, etc. are persisted in the database — not in .env.
# Edit them in the admin backoffice (System Settings) after deploy, or seed defaults:
#   php artisan db:seed --class=Database\Seeders\SystemSettingsSeeder
# Optional table name override:
# SETTINGS_TABLE=settings

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Idle minutes before web session expires (525600 ≈ 365 days). Sanctum bearer tokens: config/sanctum.php `expiration` (null = no time expiry).
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting: null (off), log, reverb. With reverb, run `composer reverb` (or add to `composer dev`).
BROADCAST_CONNECTION=reverb

# Laravel Reverb (Pusher-compatible WebSockets). Generate unique APP_KEY / APP_SECRET for each environment.
REVERB_APP_ID=100000
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Comma-separated hostnames for Reverb (default *). Full URLs are normalized to host only.
# REVERB_ALLOWED_ORIGINS=app.example.com,backoffice.example.com

FILESYSTEM_DISK=local
# Use "sync" so notifications (order placed, user registered) run immediately without a queue worker.
# Use "database" and run `php artisan queue:work` when you want background jobs.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# SMTP (e.g. Hostinger): port 465 + MAIL_SCHEME=smtps, or port 587 + MAIL_SCHEME=null and tls via your provider
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 + CloudFront (set for media to be stored on S3 and served via CloudFront)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# CloudFront URL for S3 assets (e.g. https://xxxx.cloudfront.net)
AWS_URL=
# Optional custom S3 API endpoint (e.g. MinIO)
# AWS_ENDPOINT=
# Media disk: public (local) or s3 (S3 + CloudFront)
MEDIA_DISK=public

# Used by Vite-powered frontends that read Laravel env at build time (e.g. backoffice).
VITE_APP_NAME="${APP_NAME}"
