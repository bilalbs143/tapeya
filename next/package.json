{
  "name": "user13",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less",
    "./src/polyfills.js",
    "./src/styles/**/*"
  ],
  "scripts": {
    "dev": "next dev -p 3004 --webpack",
    "build": "node scripts/generate-version.js && next build --webpack",
    "start": "next start -p 4000",
    "export": "node scripts/generate-version.js && next build --webpack",
    "prod": "npm run export && npm start",
    "build:apk": "npm run clean:out && npm run stop:gradle && npm run export && npm run config:generate && npm run clean:dev && npx cap sync && cd android && ./gradlew clean && ./gradlew assembleRelease -x lint",
    "clean": "npm run clean:out && npm run stop:gradle",
    "clean:out": "rimraf out",
    "clean:dev": "rimraf out/dev out/.next",
    "stop:gradle": "cd android && ./gradlew --stop || exit 0",
    "config:generate": "node scripts/generate-config.js",
    "postinstall": "patch-package",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix && prettier --write .",
    "analyze": "ANALYZE=true npm run build",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "BUNDLE_ANALYZE=browser npm run build",
    "build:optimized": "npm run build && npm run analyze",
    "duplicate-template": "node scripts/duplicate-template.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.3",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.2.1",
    "@lottiefiles/dotlottie-react": "^0.17.9",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@reduxjs/toolkit": "^2.11.1",
    "@tanstack/react-virtual": "^3.13.13",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "flatpickr": "^4.6.13",
    "flowbite": "^3.1.2",
    "flowbite-react": "^0.12.13",
    "framer-motion": "^12.23.26",
    "i18next": "^25.7.2",
    "joi": "^17.13.3",
    "lucide-react": "^0.561.0",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "pusher-js": "^8.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.4.0",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.0.10",
    "@next/eslint-plugin-next": "^16.0.10",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.1.18"
  }
