# See https://help.github.com/articles/ignoring-files/ for more aboutUs ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# npm lock files
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Mobile app builds and APK files
*.apk
*.aab
*.ipa
*.app
*.dmg
*.exe
*.msi

# Android build files
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/captures/
/android/gradle/
/android/gradlew
/android/gradlew.bat
/android/gradle.properties
/android/settings.gradle
/android/app/proguard-rules.pro
/android/app/release/
/android/app/debug/

# iOS build files
/ios/build/
/ios/Pods/
/ios/*.xcworkspace/
/ios/*.xcodeproj/

# Capacitor
/capacitor.config.json
/resources/

# Keystore and signing files
*.jks
*.keystore
*.p12
*.pem
*.key

# Build artifacts
*.log
*.tmp
*.temp

# Service Worker files (generated by PWA plugin)
public/sw.js
public/workbox-*.js
public/sw.js.map
public/workbox-*.js.map
public/sw.js.map
public/workbox-*.js.map
.idea