{
  "name": "tapeya-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "VITE_API_URL=https://api.tapeya.com/api/v1 VITE_APP_URL=https://tapeya.com vite build",
    "build:staging": "VITE_API_URL=https://dev-api.tapeya.com/api/v1 VITE_APP_URL=https://dev.tapeya.com vite build",
    "cap:sync": "cap sync",
    "cap:ios": "VITE_API_URL=https://api.tapeya.com/api/v1 VITE_APP_URL=https://tapeya.com VITE_NATIVE_PLATFORM=ios vite build && cap sync ios && cap open ios",
    "cap:ios:dev": "VITE_API_URL=https://dev-api.tapeya.com/api/v1 VITE_APP_URL=https://dev.tapeya.com VITE_NATIVE_PLATFORM=ios vite build && cap sync ios && cap open ios",
    "cap:android": "VITE_API_URL=https://api.tapeya.com/api/v1 VITE_APP_URL=https://tapeya.com VITE_NATIVE_PLATFORM=android vite build && cap sync android && cap open android",
    "cap:android:dev": "VITE_API_URL=https://dev-api.tapeya.com/api/v1 VITE_APP_URL=https://dev.tapeya.com VITE_NATIVE_PLATFORM=android vite build && cap sync android && cap open android",
    "preview": "vite preview",
    "clean:vite": "rm -rf node_modules/.vite",
    "dev:graphics": "vite --config vite.graphics.config.js",
    "dev:graphics:fresh": "npm run clean:vite && vite --config vite.graphics.config.js",
    "build:graphics": "vite build --config vite.graphics.config.js",
    "build:graphics:fresh": "npm run clean:vite && vite build --config vite.graphics.config.js",
    "build:graphics:production": "VITE_API_URL=https://api.tapeya.com/api/v1 npm run build:graphics",
    "build:graphics:staging": "VITE_API_URL=https://dev-api.tapeya.com/api/v1 npm run build:graphics",
    "preview:graphics": "vite preview --config vite.graphics.config.js --outDir dist-graphics --host 127.0.0.1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run lint:fix && npm run format",
    "check:graphics-drift": "node ../scripts/check-graphics-drift.js",
    "typecheck:graphics": "tsc -p src/graphics/tsconfig.json",
    "generate:graphic-fixtures": "node scripts/generate-graphic-fixtures.mjs",
    "check:graphics-output": "node ../scripts/check-graphics-output.js",
    "check:graphics-deps": "node ../scripts/check-graphics-deps.js",
    "check:consumer-no-graphics": "node ../scripts/check-consumer-no-graphics.js",
    "test:e2e:graphics-smoke": "playwright test --config playwright.graphics.config.js",
    "test:e2e:graphics": "playwright test e2e/graphics-fixtures.spec.js",
    "generate:tokens": "node scripts/generate-theme-tokens.mjs",
    "predev": "npm run generate:tokens",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.5",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@tapeya/graphics-core": "file:../shared/graphics-core",
    "apexcharts": "^5.10.2",
    "hls.js": "^1.6.16",
    "laravel-echo": "^2.3.4",
    "libphonenumber-js": "^1.13.1",
    "pusher-js": "^8.5.0",
    "react": "^18.3.1",
    "react-apexcharts": "^2.1.0",
    "react-day-picker": "^9.13.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0",
    "redux-persist": "^6.0.0",
    "swiper": "^12.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.16.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "globals": "^15.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sass": "^1.97.3",
    "tailwindcss": "^4.0.0",
    "tailwindcss3": "npm:tailwindcss@^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
