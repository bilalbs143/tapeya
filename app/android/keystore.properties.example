# Copy this file to keystore.properties (same folder as this file) and fill in real values.
# keystore.properties is gitignored — do not commit it.
#
# Create an upload keystore (one-time). Paths below are relative to this android/ folder.
#   mkdir -p keystores
#   keytool -genkeypair -v -storetype PKCS12 -keystore keystores/upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# Paths in storeFile are relative to the android/ directory (where this file lives).

storeFile=keystores/upload-keystore.jks
storePassword=REPLACE_ME
keyPassword=REPLACE_ME
keyAlias=upload
